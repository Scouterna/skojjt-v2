@page "/sk/{ScoutGroupId:int}"
@using Microsoft.AspNetCore.Authorization
@using Skojjt.Core.Authentication
@using Skojjt.Core.Entities
@using Skojjt.Core.Interfaces
@attribute [Authorize]
@inject IScoutGroupRepository ScoutGroupRepository
@inject ISemesterRepository SemesterRepository
@inject ICurrentUserService CurrentUserService
@inject NavigationManager NavigationManager

<PageTitle>@(_scoutGroup?.Name ?? "Scoutkår") - Skojjt</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudBreadcrumbs Items="_breadcrumbs" Class="mb-4" />

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
    }
    else if (!_hasAccess)
    {
        <MudAlert Severity="Severity.Error">
            Du har inte behörighet att visa denna scoutkår.
        </MudAlert>
    }
    else if (_scoutGroup == null)
    {
        <MudAlert Severity="Severity.Error">Scoutkåren kunde inte hittas.</MudAlert>
    }
    else
    {
        <MudText Typo="Typo.h4" Class="mb-2">@_scoutGroup.Name</MudText>
        @if (!string.IsNullOrEmpty(_scoutGroup.OrganisationNumber))
        {
            <MudText Typo="Typo.subtitle1" Color="Color.Secondary" Class="mb-4">
                Org.nr: @_scoutGroup.OrganisationNumber
            </MudText>
        }

        @if (_isMemberRegistrar && _showStaleImportWarning)
        {
            <MudAlert Severity="@_staleImportSeverity"
                      Class="mb-4"
                      ShowCloseIcon="false">
                <div class="d-flex align-center" style="width: 100%; gap: 12px; flex-wrap: wrap;">
                    <div style="flex: 1 1 auto;">
                        <MudText Typo="Typo.body2">
                            @_staleImportMessage
                        </MudText>
                    </div>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.CloudDownload"
                               Href="@($"/sk/{ScoutGroupId}/import")">
                        Importera nu
                    </MudButton>
                </div>
            </MudAlert>
        }

        <MudGrid>
            @* Semesters Section *@
            <MudItem xs="12" md="6">
                <MudPaper Elevation="2" Class="pa-4">
                    <div class="d-flex align-center mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.DateRange" Class="mr-2" Color="Color.Primary" />
                        <MudText Typo="Typo.h6">Terminer</MudText>
                    </div>
                    
                    @if (_semesters.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true">
                            Inga terminer med avdelningar ännu.
                        </MudAlert>
                    }
                    else
                    {
                        <MudList T="Semester" Dense="true" Class="py-0">
                            @foreach (var semester in _semesters)
                            {
                                <MudListItem T="Semester" 
                                             Icon="@Icons.Material.Filled.CalendarMonth"
                                             Href="@($"/sk/{ScoutGroupId}/t/{semester.Id}")">
                                    <div class="d-flex justify-space-between align-center" style="width: 100%;">
                                        <MudText>@semester.DisplayName</MudText>
                                        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                                    </div>
                                </MudListItem>
                            }
                        </MudList>
                    }
                </MudPaper>
            </MudItem>

            @* Quick Links Section *@
            <MudItem xs="12" md="6">
                <MudPaper Elevation="2" Class="pa-4">
                    <div class="d-flex align-center mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.Apps" Class="mr-2" Color="Color.Primary" />
                        <MudText Typo="Typo.h6">Snabblänkar</MudText>
                    </div>

                    <MudStack Spacing="2">
                        @if (_isMemberRegistrar)
                        {
                            <MudButton Variant="Variant.Outlined" 
                                       FullWidth="true" 
                                       StartIcon="@Icons.Material.Filled.CloudDownload"
                                       Href="@($"/sk/{ScoutGroupId}/import")"
                                       Class="justify-start"
                                       Color="Color.Primary">
                                Scoutnet Import
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" 
                                       FullWidth="true" 
                                       StartIcon="@Icons.Material.Filled.People"
                                       Href="@($"/sk/{ScoutGroupId}/p")"
                                       Class="justify-start">
                                Alla medlemmar
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" 
                                       FullWidth="true" 
                                       StartIcon="@Icons.Material.Filled.PersonAdd"
                                       Href="@($"/sk/{ScoutGroupId}/add-member")"
                                       Class="justify-start"
                                       Color="Color.Success">
                                Lägg till medlem
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" 
                                       FullWidth="true" 
                                       StartIcon="@Icons.Material.Filled.EmojiEvents"
                                       Href="@($"/sk/{ScoutGroupId}/badges")"
                                       Class="justify-start"
                                       Color="Color.Secondary">
                                Märken
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" 
                                       FullWidth="true" 
                                       StartIcon="@Icons.Material.Filled.Settings"
                                       Href="@($"/sk/{ScoutGroupId}/settings")"
                                       Class="justify-start">
                                Kårinställningar
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" 
                                       FullWidth="true" 
                                       StartIcon="@Icons.Material.Filled.BarChart"
                                       Href="@($"/sk/{ScoutGroupId}/grafer")"
                                       Class="justify-start"
                                       Color="Color.Tertiary">
                                Grafer
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" 
                                       FullWidth="true" 
                                       StartIcon="@Icons.Material.Filled.Timeline"
                                       Href="@($"/sk/{ScoutGroupId}/personflode")"
                                       Class="justify-start"
                                       Color="Color.Tertiary">
                                Personflöde
                            </MudButton>
                        }
                    </MudStack>
                </MudPaper>
            </MudItem>

            @* Contact Info Section *@
            <MudItem xs="12">
                <MudPaper Elevation="2" Class="pa-4">
                    <div class="d-flex align-center mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.ContactMail" Class="mr-2" Color="Color.Primary" />
                        <MudText Typo="Typo.h6">Kontaktinformation</MudText>
                    </div>
                    
                    <MudGrid>
                        @if (!string.IsNullOrEmpty(_scoutGroup.Email))
                        {
                            <MudItem xs="12" sm="6" md="4">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">E-post</MudText>
                                <MudLink Href="@($"mailto:{_scoutGroup.Email}")">@_scoutGroup.Email</MudLink>
                            </MudItem>
                        }
                        @if (!string.IsNullOrEmpty(_scoutGroup.Phone))
                        {
                            <MudItem xs="12" sm="6" md="4">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Telefon</MudText>
                                <MudLink Href="@($"tel:{_scoutGroup.Phone}")">@_scoutGroup.Phone</MudLink>
                            </MudItem>
                        }
                        @if (!string.IsNullOrEmpty(_scoutGroup.Address))
                        {
                            <MudItem xs="12" sm="6" md="4">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Adress</MudText>
                                <MudText>@_scoutGroup.Address</MudText>
                                @if (!string.IsNullOrEmpty(_scoutGroup.PostalAddress))
                                {
                                    <MudText>@_scoutGroup.PostalAddress</MudText>
                                }
                            </MudItem>
                        }
                    </MudGrid>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    [Parameter]
    public int ScoutGroupId { get; set; }

    private ScoutGroup? _scoutGroup;
    private List<Semester> _semesters = [];
    private bool _loading = true;
    private bool _hasAccess;
    private bool _isMemberRegistrar;
    private List<BreadcrumbItem> _breadcrumbs = [];

    // Stale Scoutnet import warning state
    private bool _showStaleImportWarning;
    private Severity _staleImportSeverity = Severity.Info;
    private string _staleImportMessage = string.Empty;

    // Show a warning when the last Scoutnet import is older than this threshold,
    // and escalate to an error when it is older than the error threshold.
    private static readonly TimeSpan StaleImportWarningThreshold = TimeSpan.FromDays(30);
    private static readonly TimeSpan StaleImportErrorThreshold = TimeSpan.FromDays(90);

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            // Check if user has access to this scout group
            _hasAccess = CurrentUserService.HasGroupAccess(ScoutGroupId);
            _isMemberRegistrar = CurrentUserService.IsMemberRegistrar(ScoutGroupId);
            
            if (!_hasAccess)
            {
                _breadcrumbs =
                [
                    new BreadcrumbItem("Scoutkårer", href: "/sk"),
                    new BreadcrumbItem("Ingen behörighet", href: null, disabled: true)
                ];
                return;
            }

            _scoutGroup = await ScoutGroupRepository.GetByIdAsync(ScoutGroupId);

            if (_scoutGroup != null)
            {
                var semesters = await SemesterRepository.GetByScoutGroupAsync(ScoutGroupId);
                _semesters = semesters.ToList();

                EvaluateStaleImportWarning(_scoutGroup);

                _breadcrumbs =
                [
                    new BreadcrumbItem("Scoutkårer", href: "/sk"),
                    new BreadcrumbItem(_scoutGroup.Name, href: null, disabled: true)
                ];
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private void EvaluateStaleImportWarning(ScoutGroup scoutGroup)
    {
        _showStaleImportWarning = false;
        _staleImportMessage = string.Empty;
        _staleImportSeverity = Severity.Info;

        // Only nag the people who can actually act on it.
        if (!_isMemberRegistrar)
            return;

        var lastImport = scoutGroup.LastScoutnetImportAt;
        if (lastImport == null)
        {
            _showStaleImportWarning = true;
            _staleImportSeverity = Severity.Warning;
            _staleImportMessage = "Ingen import från Scoutnet har gjorts ännu för denna kår. " +
                                  "Importera medlemmar från Scoutnet för att hålla medlemsregistret uppdaterat.";
            return;
        }

        var age = DateTime.UtcNow - lastImport.Value;
        if (age < StaleImportWarningThreshold)
            return;

        var lastImportLocal = lastImport.Value.ToLocalTime();
        var daysAgo = (int)Math.Floor(age.TotalDays);

        _showStaleImportWarning = true;
        _staleImportSeverity = age >= StaleImportErrorThreshold ? Severity.Error : Severity.Warning;
        _staleImportMessage = $"Senaste importen från Scoutnet gjordes {lastImportLocal:yyyy-MM-dd HH:mm} " +
                              $"({daysAgo} dagar sedan). Medlemsregistret i Skojjt kan vara inaktuellt jämfört med Scoutnet. " +
                              "Kör en ny import för att hålla det synkroniserat.";
    }
}
