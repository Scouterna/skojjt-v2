@page "/sk/{ScoutGroupId:int}/p/{PersonId:int}"
@using Microsoft.AspNetCore.Authorization
@using Skojjt.Core.Authentication
@using Skojjt.Core.Entities
@using Skojjt.Core.Interfaces
@using Skojjt.Core.Services
@attribute [Authorize]
@inject ICurrentUserService CurrentUserService
@inject IScoutGroupRepository ScoutGroupRepository
@inject IPersonRepository PersonRepository
@inject IBadgeService BadgeService
@inject IMyProfileService MyProfileService

<PageTitle>@(_person?.FullName ?? "Person") - Skojjt</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudBreadcrumbs Items="_breadcrumbs" Class="mb-4" />

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
    }
    else if (!_hasAccess || _person == null)
    {
        <MudAlert Severity="Severity.Error">Personen kunde inte hittas eller så saknar du behörighet att visa den.</MudAlert>
    }
    else
    {
        <MudGrid>
            @* Header with name and status *@
            <MudItem xs="12">
                <MudPaper Elevation="2" Class="pa-4">
                    <div class="d-flex flex-wrap align-center gap-2">
                        <MudAvatar Color="Color.Primary" Size="Size.Large">
                            @_person.FirstName[0]@_person.LastName[0]
                        </MudAvatar>
                        <div class="flex-grow-1">
                            <MudText Typo="Typo.h4">@_person.FullName</MudText>
                            @if (_person.BirthDate.HasValue)
                            {
                                <MudText Typo="Typo.subtitle1" Color="Color.Secondary">
                                    @_person.Age år (@_person.BirthDate.Value.ToString("yyyy-MM-dd"))
                                </MudText>
                            }
                        </div>
                        @if (_person.Removed)
                        {
                            <MudChip T="string" Color="Color.Error" Size="Size.Large">Borttagen</MudChip>
                        }
                    </div>
                </MudPaper>
            </MudItem>

            @* Contact Information *@
            <MudItem xs="12" md="6">
                <MudPaper Elevation="2" Class="pa-4" Style="height: 100%;">
                    <div class="d-flex align-center mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.ContactMail" Class="mr-2" Color="Color.Primary" />
                        <MudText Typo="Typo.h6">Kontaktuppgifter</MudText>
                    </div>
                    
                    <MudStack Spacing="2">
                        @if (!string.IsNullOrEmpty(_person.Email))
                        {
                            <div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">E-post</MudText>
                                <div class="d-flex align-center gap-2">
                                    <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" />
                                    <MudLink Href="@($"mailto:{_person.Email}")">@_person.Email</MudLink>
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(_person.AltEmail))
                        {
                            <div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Alternativ e-post</MudText>
                                <div class="d-flex align-center gap-2">
                                    <MudIcon Icon="@Icons.Material.Filled.AlternateEmail" Size="Size.Small" />
                                    <MudLink Href="@($"mailto:{_person.AltEmail}")">@_person.AltEmail</MudLink>
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(_person.Mobile))
                        {
                            <div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Mobil</MudText>
                                <div class="d-flex align-center gap-2">
                                    <MudIcon Icon="@Icons.Material.Filled.PhoneAndroid" Size="Size.Small" />
                                    <MudLink Href="@($"tel:{_person.Mobile}")">@_person.Mobile</MudLink>
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(_person.Phone))
                        {
                            <div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Telefon</MudText>
                                <div class="d-flex align-center gap-2">
                                    <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" />
                                    <MudLink Href="@($"tel:{_person.Phone}")">@_person.Phone</MudLink>
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(_person.Street))
                        {
                            <div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Adress</MudText>
                                <div class="d-flex align-center gap-2">
                                    <MudIcon Icon="@Icons.Material.Filled.Home" Size="Size.Small" />
                                    <div>
                                        <MudText>@_person.Street</MudText>
                                        @if (!string.IsNullOrEmpty(_person.ZipCode))
                                        {
                                            <MudText>@_person.ZipCode @_person.ZipName</MudText>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </MudStack>
                </MudPaper>
            </MudItem>

            @* Parent/Guardian Information *@
            <MudItem xs="12" md="6">
                <MudPaper Elevation="2" Class="pa-4" Style="height: 100%;">
                    <div class="d-flex align-center mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.FamilyRestroom" Class="mr-2" Color="Color.Primary" />
                        <MudText Typo="Typo.h6">Vårdnadshavare</MudText>
                    </div>
                    
                    <MudStack Spacing="3">
                        @if (!string.IsNullOrEmpty(_person.MumName) || !string.IsNullOrEmpty(_person.MumEmail) || !string.IsNullOrEmpty(_person.MumMobile))
                        {
                            <div>
                                <MudText Typo="Typo.subtitle2">@(_person.MumName ?? "Vårdnadshavare 1")</MudText>
                                @if (!string.IsNullOrEmpty(_person.MumEmail))
                                {
                                    <div class="d-flex align-center gap-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" />
                                        <MudLink Href="@($"mailto:{_person.MumEmail}")">@_person.MumEmail</MudLink>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(_person.MumMobile))
                                {
                                    <div class="d-flex align-center gap-2">
                                        <MudIcon Icon="@Icons.Material.Filled.PhoneAndroid" Size="Size.Small" />
                                        <MudLink Href="@($"tel:{_person.MumMobile}")">@_person.MumMobile</MudLink>
                                    </div>
                                }
                            </div>
                        }
                        
                        @if (!string.IsNullOrEmpty(_person.DadName) || !string.IsNullOrEmpty(_person.DadEmail) || !string.IsNullOrEmpty(_person.DadMobile))
                        {
                            <div>
                                <MudText Typo="Typo.subtitle2">@(_person.DadName ?? "Vårdnadshavare 2")</MudText>
                                @if (!string.IsNullOrEmpty(_person.DadEmail))
                                {
                                    <div class="d-flex align-center gap-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" />
                                        <MudLink Href="@($"mailto:{_person.DadEmail}")">@_person.DadEmail</MudLink>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(_person.DadMobile))
                                {
                                    <div class="d-flex align-center gap-2">
                                        <MudIcon Icon="@Icons.Material.Filled.PhoneAndroid" Size="Size.Small" />
                                        <MudLink Href="@($"tel:{_person.DadMobile}")">@_person.DadMobile</MudLink>
                                    </div>
                                }
                            </div>
                        }
                        
                        @if (string.IsNullOrEmpty(_person.MumName) && string.IsNullOrEmpty(_person.MumEmail) && 
                             string.IsNullOrEmpty(_person.DadName) && string.IsNullOrEmpty(_person.DadEmail))
                        {
                            <MudText Color="Color.Secondary">Ingen vårdnadshavareinformation registrerad.</MudText>
                        }
                    </MudStack>
                </MudPaper>
            </MudItem>

            @* Membership Information *@
            <MudItem xs="12" md="6">
                <MudPaper Elevation="2" Class="pa-4">
                    <div class="d-flex align-center mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.CardMembership" Class="mr-2" Color="Color.Primary" />
                        <MudText Typo="Typo.h6">Medlemskap</MudText>
                    </div>
                    
                    <MudStack Spacing="2">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Medlemsnummer</MudText>
                            <MudText>@_person.Id</MudText>
                        </div>
                        
                        @if (_person.PersonalNumber is not null)
                        {
                            <div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Personnummer</MudText>
                                <MudText>@_person.PersonalNumber</MudText>
                            </div>
                        }
                        
                        @if (_person.MemberYears.Length > 0)
                        {
                            <div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Medlemsår</MudText>
                                <MudText>@string.Join(", ", _person.MemberYears)</MudText>
                            </div>
                        }

                        @* TODO: fetch this for each ScoutGroupPerson *@
@*                         @if (!string.IsNullOrEmpty(_person.GroupRoles))
                        {
                            <div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Roller i kåren</MudText>
                                <MudText>@_person.GroupRoles</MudText>
                            </div>
                        }
 *@                    </MudStack>
                </MudPaper>
            </MudItem>

            @* Troop memberships & attendance *@
            <MudItem xs="12" md="6">
                <MudPaper Elevation="2" Class="pa-4">
                    <div class="d-flex align-center mb-4" style="cursor: pointer;" @onclick="() => _attendanceExpanded = !_attendanceExpanded">
                        <MudIcon Icon="@Icons.Material.Filled.Groups" Class="mr-2" Color="Color.Primary" />
                        <MudText Typo="Typo.h6">Avdelningar & närvaro</MudText>
                        <MudSpacer />
                        <MudIcon Icon="@(_attendanceExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" />
                    </div>

                    <MudCollapse Expanded="_attendanceExpanded">
                        <AttendanceSummaryTable Rows="_attendanceRows" EmptyText="Inte medlem i någon avdelning." />
                    </MudCollapse>
                </MudPaper>
            </MudItem>

            @* Badge Progress *@
            <MudItem xs="12">
                <MudPaper Elevation="2" Class="pa-4">
                    <div class="d-flex align-center mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Class="mr-2" Color="Color.Secondary" />
                        <MudText Typo="Typo.h6">Märkesframsteg</MudText>
                    </div>

                    <BadgeProgress Badges="_badgeProgress" ScoutGroupId="ScoutGroupId" />
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    [Parameter]
    public int ScoutGroupId { get; set; }
    
    [Parameter]
    public int PersonId { get; set; }

    private ScoutGroup? _scoutGroup;
    private Person? _person;
    private IReadOnlyList<BadgePersonSummary> _badgeProgress = [];
    private IReadOnlyList<PersonAttendanceSummary> _attendance = [];
    private IReadOnlyList<AttendanceRow> _attendanceRows = [];
    private bool _attendanceExpanded = true;
    private bool _loading = true;
    private bool _hasAccess;
    private bool _initialized;
    private int _lastLoadedScoutGroupId;
    private int _lastLoadedPersonId;
    private List<BreadcrumbItem> _breadcrumbs = new();

    protected override async Task OnInitializedAsync()
    {
        _lastLoadedScoutGroupId = ScoutGroupId;
        _lastLoadedPersonId = PersonId;
        await LoadData();
        _initialized = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_initialized) return;

        if (_lastLoadedScoutGroupId != ScoutGroupId || _lastLoadedPersonId != PersonId)
        {
            _lastLoadedScoutGroupId = ScoutGroupId;
            _lastLoadedPersonId = PersonId;
            await LoadData();
        }
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            _hasAccess = false;
            _scoutGroup = null;
            _person = null;
            _badgeProgress = [];
            _attendance = [];
            _attendanceRows = [];
            _breadcrumbs = new();

            if (!CurrentUserService.HasGroupAccess(ScoutGroupId)) return;

            var person = await PersonRepository.GetWithTroopsAsync(PersonId);

            // A missing person is reported the same way as a denied one, so the page
            // cannot be used to probe which member numbers exist.
            if (person == null) return;

            // The person must be a member of the scout group in the URL.
            if (!person.ScoutGroupPersons.Any(sgp => sgp.ScoutGroupId == ScoutGroupId)) return;

            var memberships = person.TroopPersons
                .Where(tp => tp.Troop?.ScoutGroupId == ScoutGroupId)
                .OrderByDescending(tp => tp.Troop?.SemesterId ?? 0)
                .ToList();

            // Non-registrars may only view persons in troops they have access to.
            if (!CurrentUserService.IsMemberRegistrar(ScoutGroupId)
                && !memberships.Any(tp => tp.Troop != null && CurrentUserService.HasTroopAccess(ScoutGroupId, tp.Troop.ScoutnetId)))
            {
                return;
            }

            _hasAccess = true;
            _person = person;
            _scoutGroup = await ScoutGroupRepository.GetByIdAsync(ScoutGroupId);

            if (_scoutGroup != null)
            {
                _breadcrumbs = BreadcrumbBuilder.Create()
                    .ScoutGroup(_scoutGroup.Name, ScoutGroupId)
                    .Members(ScoutGroupId)
                    .Leaf(_person.FullName);
            }

            _badgeProgress = await BadgeService.GetPersonBadgesAsync(PersonId);
            _attendance = await MyProfileService.GetAttendanceSummaryAsync(PersonId);
            _attendanceRows = BuildAttendanceRows();
        }
        finally
        {
            _loading = false;
        }
    }

    private List<AttendanceRow> BuildAttendanceRows()
    {
        // Only link to troops the user is allowed to open, so the UI never
        // offers a link that leads to a permission error.
        return AttendanceRow.FromSummaries(
            _attendance.Where(a => a.ScoutGroupId == ScoutGroupId),
            a => CurrentUserService.HasTroopAccess(a.ScoutGroupId, a.TroopScoutnetId));
    }
}
